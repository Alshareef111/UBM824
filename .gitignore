# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Editor
.vscode/
*.swp

# Raw market data (large, regenerable from Databento; manifests stay tracked)
data/raw/*.csv
data/raw/*.txt

# Large derived parquets (regenerable from raw via data_prep / build_tick_cache)
data/processed/mnq_adjusted_1m.parquet
data/processed/ticks_overlap.parquet

# Local pre-extension safety-net backups (re-creatable from clean reruns)
*.pre-extend-*

# Tick files
data/raw/MNQ*.LastT.txt
data/raw/MNQ*.LastT

# Processed parquets (large/regenerable). Keep the locked baseline trades.parquet
# as a sha256-pinned historical reference.
data/processed/*.parquet
!data/processed/trades.parquet
data/processed/*.parquet.backup

# Generated charts
results/charts/*.png
results/archive/**/*.png

# Archived experiment outputs (regenerable). Recursive so per-experiment
# subdirectories are caught too.
results/archive/**/*.parquet
